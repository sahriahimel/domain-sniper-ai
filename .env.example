# Copy this file to .env.local (local) or add these in Vercel > Settings > Environment Variables.
# You can ALSO skip all of this and paste keys into the Settings window inside the app.

# Serper.dev (live Google search) - https://serper.dev
SERPER_API_KEY=

# Groq (free tier, used for backtesting) - https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic Claude (production) - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: default AI provider when the UI has not chosen one ("groq" or "anthropic")
DEFAULT_AI_PROVIDER=groq

# Optional: override model names
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-sonnet-4-6
